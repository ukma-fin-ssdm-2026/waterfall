' AI: генерація структури та коду діаграми компонентів; перевірено: ручне проєктування, рев'ю в PR
@startuml
!theme plain
skinparam componentStyle rectangle
skinparam nodesep 50
skinparam ranksep 60
skinparam packagePadding 14

package "Client Application (.NET MAUI)" {
    [UI Components\n(Catalog, Dashboards, AI Chat)] as UI
    [HTTP Gateway Service\n(HttpClient & Bearer Auth)] as HTTPGateway
    UI -down-> HTTPGateway : SendRequestAsync()
}

package "Backend Services (C# .NET)" {
    package "Presentation Layer (ASP.NET Core Web API)" {
        [Vacancies Controller\n(/api/v1/vacancies)] as VacanciesCtrl
        [Saved Vacancies Controller\n(/api/v1/saved-vacancies)] as SavedVacanciesCtrl
        [Auth & Users Controller\n(/api/v1/auth)] as AuthCtrl
        [AI Consultant Controller\n(/api/v1/ai-consultant)] as AICtrl
    }

    package "Core Services Layer" {
        [Authentication Service] as AuthService
        [Storage Service\n(Vacancy & User Orchestration)] as StorageService
        [Analytics & Statistics Service] as AnalyticsService
        [AI Consultant Service\n(Prompt & Context Engine)] as AIService
        [Security Service\n(Crypto & Hashing)] as SecurityService
        [Cache Service\n(In-Memory / Cache-Aside)] as CacheService

        AuthService -down-> SecurityService : HashPassword()\nVerifyPassword()
        AuthService -right-> StorageService : GetUserByEmailAsync()\nCreateUserAsync()
        
        StorageService -down-> CacheService : GetAsync<T>()\nSetAsync<T>()\nRemoveByPrefixAsync()
        
        AnalyticsService -left-> StorageService : GetAggregatedDataAsync()
        AnalyticsService -down-> CacheService : SetAsync("analytics:report", ttl)
        
        AIService -left-> StorageService : GetUserContextAsync()\nSaveChatHistoryAsync()
    }

    package "Repository Layer (Data Access & External Ingestion)" {
        [Job Parser Service\n(HTML Scraper BackgroundService)] as ParserService
        [Job Ingestion &\nNormalization Service] as IngestionService
        [Data Repositories\n(EF Core DbContext)] as Repo

        ParserService -right-> IngestionService : ProcessRawVacanciesAsync(rawList)
        IngestionService -right-> Repo : BulkUpsertAsync(normalizedEntities)
    }

    ' Presentation to Core (Dependency Injection)
    VacanciesCtrl -down-> StorageService : GetVacanciesAsync(filter)\nGetVacancyByIdAsync(id)
    SavedVacanciesCtrl -down-> StorageService : GetSavedAsync(userId)\nSaveVacancyAsync(userId, id)\nDeleteSavedAsync(userId, id)
    AuthCtrl -down-> AuthService : LoginAsync(dto)\nRegisterAsync(dto)
    AICtrl -down-> AIService : AskConsultantAsync(userId, prompt)
    
    ' Core to Repository Layer
    StorageService -down-> Repo : GetPagedAsync(filter, page)\nAddSavedAsync(item)
    StorageService -down-> IngestionService : TriggerIngestionAsync()
}

database "Data Storage" {
    [Relational Database\n(MSSQL / SQLite)] as DB
}

cloud "External Services" {
    [LLM API\n(Google Gemini / OpenAI)] as AI
    [Сайти пошуку роботи\n(Work.ua, Robota.ua, Djinni)] as JobSites
}

' Client to Presentation Layer (HTTPS / REST)
HTTPGateway -down-> VacanciesCtrl : GET /api/v1/vacancies\nGET /api/v1/vacancies/{id}
HTTPGateway -down-> SavedVacanciesCtrl : GET, POST, DELETE\n/api/v1/saved-vacancies
HTTPGateway -down-> AuthCtrl : POST /api/v1/auth/login\nPOST /api/v1/auth/register
HTTPGateway -down-> AICtrl : POST /api/v1/ai-consultant/ask

' Repository to DB
Repo -down-> DB : TDS / TCP (MSSQL) or\nLocal SQLite (EF Core)

' External Interactions
ParserService -right-> JobSites : HTTPS GET (HTML Scraping\nRate-limited per-source)
AIService -right-> AI : HTTPS POST /v1beta/models\n(Timeout 30s + Fallback)

@enduml