' AI: генерація структури та коду діаграми компонентів; перевірено: ручне проєктування, рев'ю в PR
@startuml
!theme plain
skinparam componentStyle rectangle
skinparam nodesep 50
skinparam ranksep 60
skinparam packagePadding 14

package "Client Application (.NET MAUI)" {
    [DesktopHostPage / PhoneHostPage\n(IAppNavigationHost, ShellNavigationService,\nMountedPageHelper: mount tabs in RAM)] as HostPages
    [PhoneSectionHostPage\n(Header + MobileSegmentedBar,\nsub-page sliding)] as SectionHost
    [SectionPagerViewHandler\n(Android LayoutHandler,\nswipe interception)] as PagerHandler
    [Controls Library\n(VacancyListView, VacancyCard,\nOverlaySheetFrame, MobileSegmentedBar,\nAnchoredPopupMenu, ToastBanner)] as Controls
    [ThemeService\n(Warm Dark / AMOLED / Paper Light,\nLucide icon font)] as ThemeSvc
    [HTTP Gateway Service\n(HttpClient & Bearer Auth)] as HTTPGateway
    [Local Vacancy Store & Sync\n(ClientWaterfallDbContext SQLite,\nVacancySyncService, OfflineSiteCollector)] as LocalStore
    HostPages -down-> SectionHost : Mounts phone sub-sections
    SectionHost -down-> PagerHandler : Android swipe pager
    HostPages -right-> Controls : Renders views & sheets
    Controls -right-> ThemeSvc : Warm Editorial palettes
    HostPages -down-> HTTPGateway : SendRequestAsync()
    HostPages -down-> LocalStore : Offline Read/Edit &\nDirect DOU/Djinni Collect
    LocalStore -right-> HTTPGateway : POST /api/v1/vacancies/sync\nPOST /api/v1/geo/sync
}

package "Backend Services (C# .NET)" {
    package "Presentation Layer (ASP.NET Core Web API)" {
        [Vacancies Controller\n(/api/v1/vacancies, /sync,\n/categories, /recommendations)] as VacanciesCtrl
        [Site Searches Controller\n(/api/v1/site-searches,\n/site-searches/batch)] as SiteSearchesCtrl
        [Saved Vacancies Controller\n(/api/v1/saved-vacancies)] as SavedVacanciesCtrl
        [Auth, Profile & Geo Controllers\n(/api/v1/auth, /profile, /geo)] as AuthCtrl
        [Analytics & AI Controllers\n(/api/v1/analytics,\n/api/v1/ai-consultant)] as AICtrl
    }

    package "Core Services Layer" {
        [Authentication & Security Services\n(JWT, PBKDF2)] as AuthService
        [Vacancy & Saved Services\n(CRUD, Category Update, Sync)] as StorageService
        [Analytics, Recommendations &\nStats Services] as AnalyticsService
        [AI Consultant & Analysis Services\n(SSE, Relevance, FallbackChatClient)] as AIService
        [Geo Location Service\n(Photon / Wikipedia + Cache)] as GeoService
        [Cache Service\n(In-Memory Cache-Aside + Stale)] as CacheService

        StorageService -down-> CacheService : GetAsync<T>()\nSetAsync<T>()\nInvalidateCatalogAsync()
        AnalyticsService -left-> StorageService : Read Vacancies
        AIService -left-> StorageService : Search / Analyze Vacancies
    }

    package "External Ingestion (Background & On-Demand)" {
        [Job Parser Service\n(BackgroundService)] as ParserService
        [Site Search Service\n(Single & Multi-Site Batch,\nSiteCrawler, PuppeteerSharp)] as SiteSearchSvc
    }

    package "Repository Layer (Data Access)" {
        [Job Ingestion &\nNormalization Service] as IngestionService
        [Data Repositories\n(EF Core WaterfallDbContext)] as Repo

        IngestionService -right-> Repo : BulkUpsertAsync(normalizedEntities)
    }

    ParserService -down-> IngestionService : ProcessRawVacanciesAsync(rawList)
    SiteSearchSvc -down-> IngestionService : ProcessRawVacanciesAsync(rawList)

    ' Presentation to Core (Dependency Injection)
    VacanciesCtrl -down-> StorageService : GetAll / Sync / PatchCategory
    SiteSearchesCtrl -down-> SiteSearchSvc : Start / StartBatch / GetStatus
    SavedVacanciesCtrl -down-> StorageService : Get / Save / Delete
    AuthCtrl -down-> AuthService : Login / Register
    AuthCtrl -down-> GeoService : Coordinates / GeoSync
    AICtrl -down-> AIService : Messages / Analyze (SSE)
    AICtrl -down-> AnalyticsService : GetMarketAnalytics

    ' Core to Repository Layer
    StorageService -down-> Repo : GetAll / SyncMerge / BulkUpdateCategory
    GeoService -down-> Repo : GeoLocationCache
    SiteSearchSvc -down-> Repo : SiteSearchCache
}

database "Data Storage" {
    [Relational Database\n(MSSQL / SQLite)] as DB
}

cloud "External Services" {
    [LLM API\n(OpenRouter / OpenAI / Anthropic)] as AI
    [Сайти пошуку роботи\n(Work.ua, Robota.ua, Djinni, DOU)] as JobSites
}

' Client to Presentation Layer (HTTPS / REST)
HTTPGateway -down-> VacanciesCtrl : GET/POST/PUT/PATCH/DELETE\n/api/v1/vacancies/*
HTTPGateway -down-> SiteSearchesCtrl : POST/GET /api/v1/site-searches\n/api/v1/site-searches/batch
HTTPGateway -down-> SavedVacanciesCtrl : GET/POST/DELETE\n/api/v1/saved-vacancies
HTTPGateway -down-> AuthCtrl : /api/v1/auth, /profile, /geo
HTTPGateway -down-> AICtrl : /api/v1/analytics\n/api/v1/ai-consultant (SSE)

' Repository to DB
Repo -down-> DB : TDS / TCP (MSSQL) or\nLocal SQLite (EF Core)

' External Interactions
ParserService -right-> JobSites : HTTPS GET / Headless Chromium\n(Rate-limited per-source)
SiteSearchSvc -right-> JobSites : On-demand 1..4 sites\n(Parallel with per-site gates)
AIService -right-> AI : HTTPS POST (Microsoft.Extensions.AI\nTimeout 30s + Fallback Chain)

@enduml