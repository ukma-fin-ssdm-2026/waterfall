<?xml version="1.0" encoding="utf-8"?>
<!-- Спільні налаштування покриття для всіх 4 тестових проєктів: вимірюємо лише рукописний код. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Не CompilerGeneratedAttribute: ним позначено й рукописний Program з top-level statements. -->
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/*.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
