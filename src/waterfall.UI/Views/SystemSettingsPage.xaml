<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Waterfall.Client.ViewModels;assembly=waterfall.Client"
             xmlns:controls="clr-namespace:waterfall.UI.Controls"
             xmlns:res="clr-namespace:waterfall.UI.Resources"
             x:Class="waterfall.UI.Views.SystemSettingsPage"
             x:DataType="vm:SystemSettingsViewModel"
             Title="Налаштування"
             BackgroundColor="{DynamicResource DarkBg2}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 13" />
                <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
                <Setter Property="Padding" Value="18,15" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="SettingsSectionTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="TextColor" Value="{DynamicResource White}" />
            </Style>

            <Style x:Key="InfoPill" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 9" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="{DynamicResource TonalSurface}" />
                <Setter Property="Padding" Value="11,7" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="12" MaximumWidthRequest="920" HorizontalOptions="Center">

                <!-- Автозникаючий банер повідомлення про збереження / синхронізацію -->
                <controls:ToastBanner Text="{Binding StatusMessage}"
                                      Dismissed="OnDismissStatusClicked" />

                <!-- Зовнішній вигляд: Системна | Світла | Темна + AMOLED чорний -->
                <Border Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                            <Label Text="{x:Static res:Icons.Palette}"
                                   FontFamily="Lucide"
                                   FontSize="15"
                                   TextColor="{DynamicResource Primary}"
                                   VerticalOptions="Center" />
                            <Label Text="Зовнішній вигляд"
                                   Style="{StaticResource SettingsSectionTitle}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- 3-позиційний сегментований перемикач теми (Border+Label: без обрізання та VSM-глюків WinUI) -->
                        <Border StrokeShape="RoundRectangle 11"
                                StrokeThickness="0"
                                BackgroundColor="{DynamicResource TonalSurface}"
                                Padding="3"
                                WidthRequest="{OnIdiom Phone=-1, Default=336}"
                                HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                                <Border x:Name="ThemeSystemPill"
                                        Grid.Column="0"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        Background="Transparent"
                                        Padding="10,7">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnThemeSystemTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ThemeSystemLabel"
                                           Text="Системна"
                                           FontSize="12.5"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Border x:Name="ThemeLightPill"
                                        Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        Background="Transparent"
                                        Padding="10,7">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnThemeLightTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ThemeLightLabel"
                                           Text="Світла"
                                           FontSize="12.5"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Border x:Name="ThemeDarkPill"
                                        Grid.Column="2"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        Background="Transparent"
                                        Padding="10,7">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnThemeDarkTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ThemeDarkLabel"
                                           Text="Темна"
                                           FontSize="12.5"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                        <!-- Незалежний перемикач AMOLED чорний -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <HorizontalStackLayout Grid.Column="0" Spacing="7" VerticalOptions="Center">
                                <Label Text="{x:Static res:Icons.Moon}"
                                       FontFamily="Lucide"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Text="AMOLED чорний"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13.5"
                                       TextColor="{DynamicResource White}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Switch x:Name="AmoledSwitch"
                                    Grid.Column="1"
                                    Toggled="OnAmoledToggled"
                                    OnColor="{DynamicResource Primary}"
                                    ThumbColor="{DynamicResource OnPrimary}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Збір вакансій у фоні -->
                <Border Style="{StaticResource SettingsCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <FlexLayout Grid.Column="0" Wrap="Wrap" AlignItems="Center" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="7" VerticalOptions="Center" Margin="0,0,10,0">
                                <Label Text="{x:Static res:Icons.RefreshCw}" FontFamily="Lucide" FontSize="15" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                                <Label Text="Збір вакансій у фоні" Style="{StaticResource SettingsSectionTitle}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Border StrokeShape="RoundRectangle 7"
                                    StrokeThickness="0"
                                    BackgroundColor="{DynamicResource TonalSurface}"
                                    Padding="8,3"
                                    VerticalOptions="Center">
                                <Label Text="{Binding ParsingStatusBadgeText}"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </Border>
                        </FlexLayout>

                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsBackgroundParsingEnabled}"
                                Toggled="OnBackgroundParsingToggled"
                                OnColor="{DynamicResource Primary}"
                                ThumbColor="{DynamicResource OnPrimary}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Інтервал парсингу -->
                <Border Style="{StaticResource SettingsCard}">
                    <Grid RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                          RowSpacing="10"
                          ColumnSpacing="14">
                        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="7" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{x:Static res:Icons.Clock}" FontFamily="Lucide" FontSize="15" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Інтервал парсингу" Style="{StaticResource SettingsSectionTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                        </Grid>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Style="{StaticResource CompactFieldBorder}"
                                Padding="10,0"
                                WidthRequest="{OnIdiom Phone=-1, Default=230}"
                                HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                                VerticalOptions="Center">
                            <Picker Style="{StaticResource CompactPicker}"
                                    FontSize="13"
                                    ItemsSource="{Binding IntervalOptions}"
                                    SelectedItem="{Binding SelectedIntervalDisplay}"
                                    SelectedIndexChanged="OnIntervalSelectedIndexChanged" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Параметри парсингу (з конфігу) -->
                <Border Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                            <Label Text="{x:Static res:Icons.Database}" FontFamily="Lucide" FontSize="15" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                            <Label Text="Параметри парсингу" Style="{StaticResource SettingsSectionTitle}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Stretch">
                            <Border Style="{StaticResource InfoPill}" MinimumWidthRequest="125" Margin="0,0,8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="DOU сторінок" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                    <Label Text="{Binding DouPages}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource White}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource InfoPill}" MinimumWidthRequest="125" Margin="0,0,8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Work.ua сторінок" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                    <Label Text="{Binding WorkUaPages}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource White}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource InfoPill}" MinimumWidthRequest="125" Margin="0,0,8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Robota.ua сторінок" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                    <Label Text="{Binding RobotaUaPages}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource White}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource InfoPill}" MinimumWidthRequest="125" Margin="0,0,8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Djinni сторінок" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                    <Label Text="{Binding DjinniPages}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource White}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource InfoPill}" MinimumWidthRequest="125" Margin="0,0,8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Затримка запитів" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                    <Label Text="{Binding RequestDelay}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                        </FlexLayout>

                        <Label Text="{Binding ConfigFilePath}"
                               FontSize="11"
                               TextColor="{DynamicResource TextMuted}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>

                <!-- Скидання параметрів парсингу (усі перемикачі зберігаються автоматично) -->
                <FlexLayout Wrap="Wrap" JustifyContent="End" Margin="0,4,0,12">
                    <Button Text="Скинути за замовчуванням"
                            Clicked="OnResetClicked"
                            Style="{StaticResource CardAction}"
                            FontSize="12.5"
                            Padding="14,8"
                            MinimumHeightRequest="38"
                            Margin="0,0,0,8" />
                </FlexLayout>

            </VerticalStackLayout>
    </ScrollView>
</ContentPage>
