<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Waterfall.Client.ViewModels;assembly=waterfall.Client"
             xmlns:controls="clr-namespace:waterfall.UI.Controls"
             xmlns:res="clr-namespace:waterfall.UI.Resources"
             x:Class="waterfall.UI.Views.DatabasePage"
             x:DataType="vm:DatabaseViewModel"
             Title="База вакансій"
             BackgroundColor="{DynamicResource DarkBg2}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="FilterSheetTemplate" x:DataType="vm:DatabaseViewModel">
                <controls:OverlaySheetFrame Title="Фільтри"
                                            CloseCommand="{Binding ToggleFilterPanelCommand}">
                    <VerticalStackLayout Spacing="12">
                                    <Label Text="Джерела" Style="{StaticResource SheetSectionTitle}" />
                                    <FlexLayout Wrap="Wrap">
                                        <controls:FilterChipControl Text="{Binding DouFilterLabel}" Command="{Binding ToggleDouFilterCommand}" IsActive="{Binding IncludeDou}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="{Binding WorkUaFilterLabel}" Command="{Binding ToggleWorkUaFilterCommand}" IsActive="{Binding IncludeWorkUa}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="{Binding DjinniFilterLabel}" Command="{Binding ToggleDjinniFilterCommand}" IsActive="{Binding IncludeDjinni}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="{Binding RobotaUaFilterLabel}" Command="{Binding ToggleRobotaUaFilterCommand}" IsActive="{Binding IncludeRobotaUa}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="Усі" Command="{Binding SelectAllSourcesCommand}" Margin="0,0,6,6" />
                                    </FlexLayout>

                                    <Label Text="Швидкі прапорці" Style="{StaticResource SheetSectionTitle}" />
                                    <FlexLayout Wrap="Wrap">
                                        <controls:FilterChipControl Text="З ЗП" Command="{Binding ToggleOnlyWithSalaryCommand}" IsActive="{Binding OnlyWithSalary}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="Включно без ЗП" Command="{Binding ToggleIncludeNoSalaryCommand}" IsActive="{Binding IncludeNoSalary}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="Лише обрані" Command="{Binding ToggleOnlySavedCommand}" IsActive="{Binding OnlySaved}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="Без переглянутих" Command="{Binding ToggleHideViewedCommand}" IsActive="{Binding HideViewed}" IsVisible="{Binding CanTrackViews}" Margin="0,0,6,6" />
                                        <controls:FilterChipControl Text="Лише в назві" Command="{Binding ToggleTitleOnlyCommand}" IsActive="{Binding TitleOnly}" Margin="0,0,6,6" />
                                    </FlexLayout>

                                    <Label Text="Категорії, досвід та формат" Style="{StaticResource SheetSectionTitle}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"><Label Text="Група категорій" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding CategoryGroupOptions}" SelectedItem="{Binding SelectedCategoryGroup}" /></Border></VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1"><Label Text="Точна категорія в БД" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" /></Border></VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"><Label Text="Формат роботи" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding WorkFormatOptions}" SelectedItem="{Binding SelectedWorkFormat}" /></Border></VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1"><Label Text="Досвід роботи" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding ExperienceOptions}" SelectedItem="{Binding SelectedExperience}" /></Border></VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"><Label Text="Місто (з БД)" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding AvailableLocations}" SelectedItem="{Binding SelectedLocation}" /></Border></VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1"><Label Text="Свіжість публікації" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding FreshnessOptions}" SelectedItem="{Binding SelectedFreshness}" /></Border></VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"><Label Text="Статус" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" /></Border></VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1"><Label Text="Сортування" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" /></Border></VerticalStackLayout>
                                    </Grid>

                                    <Label Text="Пошук за полями та зарплата" Style="{StaticResource SheetSectionTitle}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"><Label Text="Локація / Адреса" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding LocationFilter}" ReturnCommand="{Binding ApplyFiltersCommand}" Placeholder="Київ, Поділ, Remote..." /></Border></VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1"><Label Text="Компанія" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding CompanyFilter}" ReturnCommand="{Binding ApplyFiltersCommand}" Placeholder="Назва компанії..." /></Border></VerticalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout><Label Text="Обов'язкові навички (через кому)" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding SkillsFilter}" ReturnCommand="{Binding ApplyFiltersCommand}" Placeholder="C#, Docker, SQL..." /></Border></VerticalStackLayout>
                                    <VerticalStackLayout>
                                        <Label Text="Зарплата (від — до, крос-валютна)" Style="{StaticResource CompactFieldLabel}" />
                                        <Grid ColumnDefinitions="*,*,94" ColumnSpacing="6">
                                            <Border Grid.Column="0" Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding MinSalaryFilter}" ReturnCommand="{Binding ApplyFiltersCommand}" Placeholder="Від" Keyboard="Numeric" /></Border>
                                            <Border Grid.Column="1" Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding MaxSalaryFilter}" ReturnCommand="{Binding ApplyFiltersCommand}" Placeholder="До" Keyboard="Numeric" /></Border>
                                            <Border Grid.Column="2" Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding SalaryCurrencyOptions}" SelectedItem="{Binding SelectedSalaryCurrency}" /></Border>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <controls:WordListEditorCard Title="Вайт-лист слів"
                                                                 Placeholder="Слова через кому..."
                                                                 ShowMatchMode="True"
                                                                 MatchModeText="{Binding WhiteListMatchText}"
                                                                 ToggleMatchModeCommand="{Binding ToggleWhiteListMatchAllCommand}"
                                                                 Words="{Binding WhiteListWords}"
                                                                 HasWords="{Binding HasWhiteListWords}"
                                                                 NewWordText="{Binding NewWhiteListWord, Mode=TwoWay}"
                                                                 AddWordCommand="{Binding AddWhiteListWordCommand}"
                                                                 RemoveWordCommand="{Binding RemoveWhiteListWordCommand}"
                                                                 ClearWordsCommand="{Binding ClearWhiteListWordsCommand}" />

                                    <controls:WordListEditorCard Title="Бан-слова (виключити)"
                                                                 Placeholder="Мінус-слова через кому..."
                                                                 IsDanger="True"
                                                                 Words="{Binding BanListWords}"
                                                                 HasWords="{Binding HasBanListWords}"
                                                                 NewWordText="{Binding NewBanListWord, Mode=TwoWay}"
                                                                 AddWordCommand="{Binding AddBanListWordCommand}"
                                                                 RemoveWordCommand="{Binding RemoveBanListWordCommand}"
                                                                 ClearWordsCommand="{Binding ClearBanListWordsCommand}" />
                    </VerticalStackLayout>

                    <controls:OverlaySheetFrame.FooterContent>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Скинути" Command="{Binding ResetFiltersCommand}" Style="{StaticResource CardAction}" />
                            <Button Grid.Column="1" Text="Застосувати фільтри" Clicked="OnApplyAndCloseFilterSheetClicked" Style="{StaticResource CardActionPrimary}" />
                        </Grid>
                    </controls:OverlaySheetFrame.FooterContent>
                </controls:OverlaySheetFrame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- ==================== ШАР 0: БАЗА ВАКАНСІЙ ==================== -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

            <!-- Рядок 0: Пошук + Сортування + Фільтри + (на Desktop: [Офлайн], Синхронізувати, ⋮) -->
            <controls:VacancySearchToolbar Grid.Row="0"
                                           SearchText="{Binding SearchText}"
                                           SearchPlaceholder="Пошук по всій базі..."
                                           SearchCommand="{Binding ApplyFiltersCommand}"
                                           SortOptions="{Binding SortOptions}"
                                           SelectedSortOption="{Binding SelectedSortOption}"
                                           IsCustomSortActive="{Binding IsCustomSortActive}"
                                           SortMenuClicked="OnSortMenuClicked"
                                           FilterCommand="{Binding ToggleFilterPanelCommand}"
                                           FilterDescription="Усі 15 фільтрів бази"
                                           IsFilterActive="{Binding IsFilterHighlightActive}">
                <HorizontalStackLayout Spacing="6" IsVisible="{OnIdiom Phone=False, Default=True}">
                    <Border IsVisible="{Binding IsOfflineMode}"
                            StrokeShape="RoundRectangle 9"
                            StrokeThickness="0"
                            BackgroundColor="{DynamicResource TonalSurface}"
                            HeightRequest="38"
                            Padding="10,0"
                            VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{x:Static res:Icons.WifiOff}"
                                   FontFamily="Lucide"
                                   FontSize="12.5"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Label Text="Офлайн"
                                   FontSize="11.5"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Button Text="{Binding SyncButtonText}"
                            Command="{Binding SyncDatabaseCommand}"
                            Style="{StaticResource CardActionPrimary}"
                            FontSize="12"
                            Padding="14,6"
                            HeightRequest="38"
                            MinimumHeightRequest="38"
                            CornerRadius="10"
                            SemanticProperties.Hint="Двостороння синхронізація локальної бази вакансій із сервером" />

                    <Button Text="{x:Static res:Icons.EllipsisVertical}"
                            Clicked="OnOverflowClicked"
                            Style="{StaticResource IconButton}"
                            HeightRequest="38" WidthRequest="38" MinimumHeightRequest="38" MinimumWidthRequest="38"
                            SemanticProperties.Description="Оновити, експорт та імпорт БД" />
                </HorizontalStackLayout>
            </controls:VacancySearchToolbar>

            <!-- Рядок 1 (лише Desktop): Компактна смуга швидких фільтрів + перехід до сайтів у панелі фільтрів -->
            <ScrollView Grid.Row="1"
                        IsVisible="{OnIdiom Phone=False, Default=True}"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="12,0,12,6">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <controls:FilterChipControl Text="{Binding SourcesChipText}"
                                                Command="{Binding ToggleFilterPanelCommand}"
                                                SemanticProperties.Description="Обрати сайти вакансій у фільтрах" />

                    <BoxView WidthRequest="1" HeightRequest="18" Color="{DynamicResource DividerColor}" Margin="2,0" VerticalOptions="Center" />

                    <controls:FilterChipControl Text="З ЗП" Command="{Binding ToggleOnlyWithSalaryCommand}" IsActive="{Binding OnlyWithSalary}" />
                    <controls:FilterChipControl Text="Обрані" Command="{Binding ToggleOnlySavedCommand}" IsActive="{Binding OnlySaved}" />
                    <controls:FilterChipControl Text="Без переглянутих" Command="{Binding ToggleHideViewedCommand}" IsActive="{Binding HideViewed}" IsVisible="{Binding CanTrackViews}" />
                    <controls:FilterChipControl Text="Скинути" Command="{Binding ResetFiltersCommand}" IsAccentText="True" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Рядок 2: Автозникаючий інформаційний банер з індикатором часу -->
            <controls:ToastBanner Grid.Row="2"
                                  Text="{Binding StatusBannerText}"
                                  Dismissed="OnDismissStatusBanner"
                                  Margin="12,0,12,6" />

            <!-- Рядок 3: Банер помилки -->
            <Border Grid.Row="3"
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource ErrorBanner}"
                    Margin="12,0,12,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding ErrorMessage}" VerticalOptions="Center" Style="{StaticResource ErrorLabel}" FontSize="12" />
                    <Button Grid.Column="1" Text="{x:Static res:Icons.X}" Command="{Binding DismissErrorCommand}" Style="{StaticResource GhostIconButton}" TextColor="{DynamicResource Danger}" WidthRequest="26" HeightRequest="26" MinimumWidthRequest="26" MinimumHeightRequest="26" />
                </Grid>
            </Border>

            <!-- Рядок 4: Тихий офлайн-індикатор на телефоні (0px висоти в онлайні) -->
            <Grid Grid.Row="4"
                  IsVisible="{OnIdiom Phone=True, Default=False}">
                <Border IsVisible="{Binding IsOfflineMode}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource TonalSurface}"
                        HorizontalOptions="Start"
                        Margin="12,0,12,6"
                        Padding="9,5">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.WifiOff}"
                               FontFamily="Lucide"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               VerticalOptions="Center" />
                        <Label Text="Офлайн · локальна БД"
                               FontSize="11.5"
                               FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Рядок 5: Повний список вакансій із БД -->
            <controls:VacancyListView Grid.Row="5"
                                      ItemsSource="{Binding Vacancies}"
                                      EnablePullToRefresh="True"
                                      IsRefreshing="{Binding IsRefreshing}"
                                      RefreshCommand="{Binding RefreshCommand}">
                <VerticalStackLayout Padding="28,36" Spacing="12" VerticalOptions="Center" IsVisible="{Binding IsEmpty}">
                    <Border WidthRequest="54" HeightRequest="54" StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="{DynamicResource TonalSurface}" HorizontalOptions="Center">
                        <Label Text="{x:Static res:Icons.Database}" FontFamily="Lucide" FontSize="22" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="У базі немає вакансій за обраними фільтрами" HorizontalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource CardTitle}" />
                    <Label Text="Скиньте фільтри, синхронізуйтеся із сервером або спарсіть нові вакансії в Каталозі." HorizontalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource MutedLabel}" MaximumWidthRequest="330" />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,4,0,0">
                        <Button Text="Скинути фільтри" Command="{Binding ResetFiltersCommand}" Style="{StaticResource CardAction}" />
                        <Button Text="{Binding SyncButtonText}" Command="{Binding SyncDatabaseCommand}" Style="{StaticResource CardActionPrimary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </controls:VacancyListView>
        </Grid>

        <!-- ==================== ШАР 1: ЛІНИВИЙ OVERLAY SHEET — ФІЛЬТРИ БД ==================== -->
        <ContentView x:Name="FilterSheetHost" IsVisible="False" />

        <!-- ==================== ШАР 2: КОНТЕКСТНЕ МЕНЮ ⋮ (ЯКІРНЕ, ЗА ТЕМОЮ) ==================== -->
        <controls:AnchoredPopupMenu x:Name="OverflowMenuLayer"
                                    MenuMargin="{OnIdiom Phone='0,4,12,0', Default='0,50,12,0'}">
            <VerticalStackLayout Spacing="2">
                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="10,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshDatabaseTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.RefreshCw}" FontFamily="Lucide" FontSize="14" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Text="Оновити базу" FontSize="13" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" Margin="6,2" />

                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="10,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExportJsonTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.Download}" FontFamily="Lucide" FontSize="14" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Text="Експорт у JSON" FontSize="13" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="10,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImportJsonTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.Upload}" FontFamily="Lucide" FontSize="14" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Text="Імпорт із JSON" FontSize="13" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" Margin="6,2" />

                <Label Text="{Binding LastSyncedMenuText}"
                       FontSize="11"
                       TextColor="{DynamicResource TextMuted}"
                       Padding="10,4,10,5"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </controls:AnchoredPopupMenu>

        <!-- ==================== ШАР 3: МЕНЮ СОРТУВАННЯ (ЯКІРНЕ НА PHONE) ==================== -->
        <controls:AnchoredPopupMenu x:Name="SortMenuLayer"
                                    MenuMargin="{OnIdiom Phone='0,46,56,0', Default='0,48,56,0'}">
            <VerticalStackLayout x:Name="SortOptionsStack" Spacing="2" />
        </controls:AnchoredPopupMenu>

    </Grid>
</ContentPage>
