<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Waterfall.Client.ViewModels;assembly=waterfall.Client"
             xmlns:controls="clr-namespace:waterfall.UI.Controls"
             xmlns:res="clr-namespace:waterfall.UI.Resources"
             x:Class="waterfall.UI.Views.AIConsultantPage"
             x:DataType="vm:AIConsultantViewModel"
             Title="ШІ-консультант"
             BackgroundColor="{DynamicResource DarkBg2}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- Phone Header -->
        <Grid Grid.Row="0"
              IsVisible="{OnIdiom Phone=True, Default=False}"
              ColumnDefinitions="*,Auto"
              Padding="14,10,12,6">
            <Label Text="ШІ-чат"
                   FontFamily="OpenSansSemibold"
                   FontSize="20"
                   TextColor="{DynamicResource White}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Очистити"
                    Command="{Binding ClearChatCommand}"
                    Style="{StaticResource LinkButton}"
                    FontSize="12"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Швидкі запити-підказки + «Очистити чат» (Desktop) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,8,12,8">
            <ScrollView Grid.Column="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding QuickPrompts}" Spacing="8" Padding="0,0,4,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AIConsultantViewModel}}, Path=SendQuickPromptCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource CardAction}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="16" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Button Grid.Column="1"
                    IsVisible="{OnIdiom Phone=False, Default=True}"
                    Text="Очистити"
                    Command="{Binding ClearChatCommand}"
                    Style="{StaticResource LinkButton}"
                    FontSize="12"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Помилка -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">
            <Label Text="{Binding ErrorMessage}"
                   VerticalOptions="Center"
                   Style="{StaticResource ErrorLabel}" />
        </Border>

        <!-- Список повідомлень діалогу (US-005) -->
        <CollectionView x:Name="MessagesView"
                        Grid.Row="3"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        Margin="12,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AIChatMessageViewModel">
                    <Grid Margin="0,6" ColumnDefinitions="Auto,*,Auto">

                        <!-- Повідомлення користувача (праворуч, акцентний теракот) -->
                        <Border Grid.Column="1"
                                Grid.ColumnSpan="2"
                                IsVisible="{Binding IsUser}"
                                HorizontalOptions="End"
                                MaximumWidthRequest="480"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                BackgroundColor="{DynamicResource Primary}"
                                Padding="14,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Text}"
                                       TextColor="{DynamicResource OnPrimary}"
                                       FontSize="14" />
                                <Label Text="{Binding TimeText}"
                                       TextColor="{DynamicResource OnPrimary}"
                                       Opacity="0.78"
                                       FontSize="10"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Повідомлення ШІ-асистента (ліворуч) -->
                        <Border Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsVisible="{Binding IsBot}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="540"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="{DynamicResource CardBorder}"
                                BackgroundColor="{DynamicResource DarkBg1}"
                                Padding="14,12">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{x:Static res:Icons.Bot}"
                                           FontFamily="Lucide"
                                           FontSize="14"
                                           TextColor="{DynamicResource Primary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Waterfall AI"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="{DynamicResource Primary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding Text}"
                                       TextColor="{DynamicResource White}"
                                       FontSize="14" />

                                <!-- Оцінка релевантності вакансії з результату /analyze (FR-010) -->
                                <Label Text="{Binding RelevanceText}"
                                       IsVisible="{Binding HasRelevance}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13"
                                       TextColor="{DynamicResource Primary}" />

                                <!-- Позначка розбіжності за US-005 AC-3 (<100%) -->
                                <Border IsVisible="{Binding HasDisclaimer}"
                                        Style="{StaticResource ErrorBanner}"
                                        Margin="0,4">
                                    <Label Text="{Binding MatchDisclaimer}"
                                           Style="{StaticResource ErrorLabel}"
                                           FontSize="12" />
                                </Border>

                                <!-- Які саме критерії знято, щоб знайти хоч щось (US-005 AC-3) -->
                                <Label Text="{Binding RelaxedFilters}"
                                       IsVisible="{Binding HasRelaxedFilters}"
                                       Style="{StaticResource MutedLabel}"
                                       FontSize="11" />

                                <!-- Вкладені рекомендовані вакансії (US-005 AC-1) -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MatchedVacancies}"
                                                     IsVisible="{Binding HasVacancies}"
                                                     Spacing="6"
                                                     Margin="0,6,0,0">
                                    <Label Text="Знайдені відповідні вакансії:"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="{DynamicResource Primary}" />
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VacancyItemViewModel">
                                            <controls:VacancyCard />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- REL-003: запасний шлях, коли ШІ недоступний або вичерпано ліміт запитів -->
                                <Button Text="Перейти до каталогу"
                                        IsVisible="{Binding ShowCatalogAction}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AIConsultantViewModel}}, Path=GoToCatalogCommand}"
                                        Style="{StaticResource LinkButton}"
                                        HorizontalOptions="Start"
                                        FontSize="12" />

                                <Label Text="{Binding TimeText}"
                                       Style="{StaticResource MutedLabel}"
                                       FontSize="10"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Індикатор генерації відповіді -->
        <HorizontalStackLayout Grid.Row="4"
                               IsVisible="{Binding IsThinking}"
                               Spacing="8"
                               Padding="16,8">
            <ActivityIndicator IsRunning="{Binding IsThinking}"
                               HeightRequest="16"
                               WidthRequest="16" />
            <Label Text="{Binding StatusHint}"
                   Style="{StaticResource MutedLabel}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Панель введення повідомлення -->
        <Border Grid.Row="5"
                StrokeShape="Rectangle"
                StrokeThickness="1"
                Stroke="{DynamicResource DividerColor}"
                BackgroundColor="{DynamicResource DarkBg1}"
                Padding="12,10">
            <VerticalStackLayout Spacing="7">
                <!-- THR-06: попередження про персональні дані -->
                <Border StrokeShape="RoundRectangle 7"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource TonalSurface}"
                        Padding="8,4"
                        HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.TriangleAlert}"
                               FontFamily="Lucide"
                               FontSize="11"
                               TextColor="{DynamicResource Primary}"
                               VerticalOptions="Center" />
                        <Label Text="Не вводьте персональні дані"
                               Style="{StaticResource MutedLabel}"
                               FontSize="11"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Style="{StaticResource CompactFieldBorder}"
                            StrokeShape="RoundRectangle 20">
                        <Entry Style="{StaticResource CompactEntry}"
                               Text="{Binding InputText}"
                               Placeholder="Запитайте про вакансії..."
                               ReturnCommand="{Binding SendMessageCommand}" />
                    </Border>
                    <Button Grid.Column="1"
                            Text="Надіслати"
                            Command="{Binding SendMessageCommand}"
                            CornerRadius="20"
                            Style="{StaticResource CardActionPrimary}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
