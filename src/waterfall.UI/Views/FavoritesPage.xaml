<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Waterfall.Client.ViewModels;assembly=waterfall.Client"
             xmlns:controls="clr-namespace:waterfall.UI.Controls"
             xmlns:res="clr-namespace:waterfall.UI.Resources"
             x:Class="waterfall.UI.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title="Обране"
             BackgroundColor="{DynamicResource DarkBg2}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Phone Header -->
        <Grid Grid.Row="0"
              IsVisible="{OnIdiom Phone=True, Default=False}"
              Padding="14,10,12,6">
            <Label Text="Обране"
                   FontFamily="OpenSansSemibold"
                   FontSize="20"
                   TextColor="{DynamicResource White}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Банер помилки -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding ErrorMessage}"
                       VerticalOptions="Center"
                       Style="{StaticResource ErrorLabel}" />
                <Button Grid.Column="1"
                        Text="Повторити"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource CardActionPrimary}" />
            </Grid>
        </Border>

        <!-- Підсумок збережених вакансій та спіннер -->
        <Grid Grid.Row="2" Padding="14,6" ColumnDefinitions="*,Auto">
            <Label Text="{Binding TotalText}"
                   IsVisible="{Binding ShowTotal}"
                   Style="{StaticResource MutedLabel}"
                   VerticalOptions="Center" />
            <ActivityIndicator Grid.Column="1"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HeightRequest="20"
                               WidthRequest="20" />
        </Grid>

        <!-- Список збережених вакансій -->
        <controls:VacancyListView Grid.Row="3"
                                  ItemsSource="{Binding Vacancies}"
                                  EnablePullToRefresh="True"
                                  IsRefreshing="{Binding IsRefreshing}"
                                  RefreshCommand="{Binding RefreshCommand}">
            <VerticalStackLayout Padding="32"
                                 Spacing="10"
                                 IsVisible="{Binding IsEmpty}">
                <Label Text="{x:Static res:Icons.Heart}"
                       FontFamily="Lucide"
                       FontSize="34"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center" />
                <Label Text="Тут поки порожньо"
                       HorizontalOptions="Center"
                       Style="{StaticResource CardTitle}" />
                <Label Text="Зберігайте цікаві вакансії кнопкою серця у каталозі, щоб вони з'явилися тут"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
        </controls:VacancyListView>
    </Grid>
</ContentPage>
