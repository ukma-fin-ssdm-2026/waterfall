<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Waterfall.Client.ViewModels;assembly=waterfall.Client"
             xmlns:controls="clr-namespace:waterfall.UI.Controls"
             xmlns:res="clr-namespace:waterfall.UI.Resources"
             x:Class="waterfall.UI.Views.CatalogPage"
             x:DataType="vm:CatalogViewModel"
             Title="Каталог"
             BackgroundColor="{DynamicResource DarkBg2}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ChoiceChip" x:DataType="vm:SelectableOption">
                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource TonalSurface}"
                        Padding="10,5"
                        Margin="0,0,6,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource InkPillBg}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding Label}" FontSize="11.5" TextColor="{DynamicResource TextSecondary}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource InkPillText}" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ParseSheetTemplate" x:DataType="vm:CatalogViewModel">
                <!-- ==================== ШАР 1: OVERLAY SHEET — ПАРСИНГ САЙТІВ ==================== -->
                <controls:OverlaySheetFrame Title="Параметри парсингу"
                                            CloseCommand="{Binding ToggleParsePanelCommand}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Спільні ключові слова для сайтів" Style="{StaticResource CompactFieldLabel}" />
                            <Border Style="{StaticResource CompactFieldBorder}">
                                <Entry Style="{StaticResource CompactEntry}" Text="{Binding SiteKeywords}" Placeholder="python, .NET, бухгалтер, водій…" ReturnCommand="{Binding FetchFromSitesCommand}" />
                            </Border>
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Усі 4" Command="{Binding SelectAllParseSitesCommand}" Style="{StaticResource FilterChip}" />
                                <Button Text="Жодного" Command="{Binding ClearParseSitesCommand}" Style="{StaticResource FilterChip}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- 1) DOU -->
                        <controls:CollapsibleSiteCard SiteName="DOU"
                                                      Subtitle="· 25 найсвіжіших"
                                                      IsSiteEnabled="{Binding IsDouParseEnabled}"
                                                      ToggleSiteCommand="{Binding ToggleDouParseCommand}"
                                                      IsExpanded="{Binding IsDouPanelVisible}"
                                                      ToggleExpandCommand="{Binding SelectDouFilterCommand}">
                            <VerticalStackLayout Spacing="8">
                                <VerticalStackLayout>
                                    <Label Text="Категорія DOU" Style="{StaticResource CompactFieldLabel}" />
                                    <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                        <Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DouCategoryOptions}" SelectedItem="{Binding DouSelectedCategory}" />
                                    </Border>
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Досвід роботи" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DouExperienceOptions}" SelectedItem="{Binding DouSelectedExperience}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Місто України" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DouCityOptions}" SelectedItem="{Binding DouSelectedCity}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </controls:CollapsibleSiteCard>

                        <!-- 2) Work.ua -->
                        <controls:CollapsibleSiteCard SiteName="Work.ua"
                                                      IsSiteEnabled="{Binding IsWorkUaParseEnabled}"
                                                      ToggleSiteCommand="{Binding ToggleWorkUaParseCommand}"
                                                      IsExpanded="{Binding IsWorkUaPanelVisible}"
                                                      ToggleExpandCommand="{Binding SelectWorkUaFilterCommand}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="З стор. (1–50)" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Entry Style="{StaticResource CompactEntry}" Text="{Binding WorkUaFromPage}" Keyboard="Numeric" HorizontalTextAlignment="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Сторінок" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Entry Style="{StaticResource CompactEntry}" Text="{Binding WorkUaPagesToParse}" Keyboard="Numeric" HorizontalTextAlignment="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Місто / Регіон" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding WorkUaCityOptions}" SelectedItem="{Binding WorkUaSelectedCity}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Досвід роботи" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding WorkUaExperienceOptions}" SelectedItem="{Binding WorkUaSelectedExperience}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout>
                                    <Label Text="Період публікації" Style="{StaticResource CompactFieldLabel}" />
                                    <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                        <Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding WorkUaDaysOptions}" SelectedItem="{Binding WorkUaSelectedDays}" />
                                    </Border>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Зарплата від (грн)" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Entry Style="{StaticResource CompactEntry}" Text="{Binding WorkUaSalaryFrom}" Keyboard="Numeric" Placeholder="грн" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Зарплата до (грн)" Style="{StaticResource CompactFieldLabel}" />
                                        <Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}">
                                            <Entry Style="{StaticResource CompactEntry}" Text="{Binding WorkUaSalaryTo}" Keyboard="Numeric" Placeholder="грн" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <FlexLayout Wrap="Wrap" AlignItems="Center">
                                    <HorizontalStackLayout Spacing="4" Margin="0,0,12,4" VerticalOptions="Center">
                                        <CheckBox Style="{StaticResource CompactCheckBox}" IsChecked="{Binding WorkUaIncludeNoSalary}" />
                                        <Label Text="Включно без ЗП" FontSize="12" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" Margin="0,0,0,4" VerticalOptions="Center">
                                        <CheckBox Style="{StaticResource CompactCheckBox}" IsChecked="{Binding WorkUaForStudents}" />
                                        <Label Text="Для студентів" FontSize="12" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </FlexLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="Вид зайнятості" Style="{StaticResource CompactFieldLabel}" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="Усі" Command="{Binding SelectAllChoicesCommand}" CommandParameter="{Binding WorkUaEmploymentChoices}" Style="{StaticResource LinkButton}" FontSize="11" />
                                        <Button Grid.Column="2" Text="Очистити" Command="{Binding ClearChoicesCommand}" CommandParameter="{Binding WorkUaEmploymentChoices}" Style="{StaticResource LinkButton}" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                                    </Grid>
                                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding WorkUaEmploymentChoices}" BindableLayout.ItemTemplate="{StaticResource ChoiceChip}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="Знання мов" Style="{StaticResource CompactFieldLabel}" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="Усі" Command="{Binding SelectAllChoicesCommand}" CommandParameter="{Binding WorkUaLanguageChoices}" Style="{StaticResource LinkButton}" FontSize="11" />
                                        <Button Grid.Column="2" Text="Очистити" Command="{Binding ClearChoicesCommand}" CommandParameter="{Binding WorkUaLanguageChoices}" Style="{StaticResource LinkButton}" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                                    </Grid>
                                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding WorkUaLanguageChoices}" BindableLayout.ItemTemplate="{StaticResource ChoiceChip}" />
                                </VerticalStackLayout>

                                <Border StrokeShape="RoundRectangle 9" Stroke="{DynamicResource CardBorder}" BackgroundColor="{DynamicResource DarkBg1}" Padding="10,8">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="Сфери Work.ua (25)" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{DynamicResource White}" VerticalOptions="Center">
                                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleWorkUaSpheresTapped" /></Label.GestureRecognizers>
                                            </Label>
                                            <Button Grid.Column="1" Text="Усі" Command="{Binding SelectAllChoicesCommand}" CommandParameter="{Binding WorkUaCategoryChoices}" Style="{StaticResource LinkButton}" FontSize="11" />
                                            <Button Grid.Column="2" Text="Очистити" Command="{Binding ClearChoicesCommand}" CommandParameter="{Binding WorkUaCategoryChoices}" Style="{StaticResource LinkButton}" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                                            <Button x:Name="WorkUaSpheresChevron" Grid.Column="3" Text="{x:Static res:Icons.ChevronDown}" Clicked="OnToggleWorkUaSpheresClicked" Style="{StaticResource GhostIconButton}" WidthRequest="28" HeightRequest="28" MinimumWidthRequest="28" MinimumHeightRequest="28" />
                                        </Grid>
                                        <FlexLayout x:Name="WorkUaSpheresPanel" IsVisible="False" Wrap="Wrap" BindableLayout.ItemsSource="{Binding WorkUaCategoryChoices}" BindableLayout.ItemTemplate="{StaticResource ChoiceChip}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0" Style="{StaticResource CompactCheckBox}" IsChecked="{Binding WorkUaOpenJobPages}" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Відкривати кожну вакансію" FontSize="12" TextColor="{DynamicResource White}" />
                                        <Label Text="{Binding WorkUaJobPagesHint}" FontSize="11" TextColor="{DynamicResource TextMuted}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </controls:CollapsibleSiteCard>

                        <!-- 3) Djinni -->
                        <controls:CollapsibleSiteCard SiteName="Djinni"
                                                      IsSiteEnabled="{Binding IsDjinniParseEnabled}"
                                                      ToggleSiteCommand="{Binding ToggleDjinniParseCommand}"
                                                      IsExpanded="{Binding IsDjinniPanelVisible}"
                                                      ToggleExpandCommand="{Binding SelectDjinniFilterCommand}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="З стор. (1–50)" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding DjinniFromPage}" Keyboard="Numeric" HorizontalTextAlignment="Center" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Сторінок" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding DjinniPagesToParse}" Keyboard="Numeric" HorizontalTextAlignment="Center" /></Border></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="Категорія / Стек" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniCategoryOptions}" SelectedItem="{Binding DjinniSelectedCategory}" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Досвід роботи" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniExperienceOptions}" SelectedItem="{Binding DjinniSelectedExperience}" /></Border></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="Зайнятість" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniEmploymentOptions}" SelectedItem="{Binding DjinniSelectedEmployment}" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Рівень англійської" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniEnglishOptions}" SelectedItem="{Binding DjinniSelectedEnglish}" /></Border></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="Тип компанії" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniCompanyTypeOptions}" SelectedItem="{Binding DjinniSelectedCompanyType}" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Домен / Індустрія" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniDomainOptions}" SelectedItem="{Binding DjinniSelectedDomain}" /></Border></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="Регіон пошуку" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniRegionOptions}" SelectedItem="{Binding DjinniSelectedRegion}" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Місто (Україна)" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniCityOptions}" SelectedItem="{Binding DjinniSelectedCity}" /></Border></VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout><Label Text="Країна релокації / найму" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding DjinniCountryOptions}" SelectedItem="{Binding DjinniSelectedCountry}" /></Border></VerticalStackLayout>
                            </VerticalStackLayout>
                        </controls:CollapsibleSiteCard>

                        <!-- 4) Robota.ua -->
                        <controls:CollapsibleSiteCard SiteName="Robota.ua"
                                                      IsSiteEnabled="{Binding IsRobotaUaParseEnabled}"
                                                      ToggleSiteCommand="{Binding ToggleRobotaUaParseCommand}"
                                                      IsExpanded="{Binding IsRobotaUaPanelVisible}"
                                                      ToggleExpandCommand="{Binding SelectRobotaUaFilterCommand}">
                            <VerticalStackLayout Spacing="8">
                                <VerticalStackLayout><Label Text="Ключові слова Robota.ua" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding RobotaUaSearchQuery}" Placeholder="Напр. QA, Python..." /></Border></VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="З стор. (1–50)" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding RobotaUaFromPage}" Keyboard="Numeric" HorizontalTextAlignment="Center" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Сторінок" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding RobotaUaPagesToParse}" Keyboard="Numeric" HorizontalTextAlignment="Center" /></Border></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="Місто" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding RobotaUaCityOptions}" SelectedItem="{Binding RobotaUaSelectedCity}" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Тип зайнятості" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding RobotaUaEmploymentOptions}" SelectedItem="{Binding RobotaUaSelectedEmployment}" /></Border></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0"><Label Text="Зарплата від" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding RobotaUaSalaryOptions}" SelectedItem="{Binding RobotaUaSelectedSalary}" /></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="Досвід роботи" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}" BackgroundColor="{DynamicResource DarkBg1}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding RobotaUaExperienceOptions}" SelectedItem="{Binding RobotaUaSelectedExperience}" /></Border></VerticalStackLayout>
                                </Grid>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <CheckBox Style="{StaticResource CompactCheckBox}" IsChecked="{Binding RobotaUaIncludeNoSalary}" />
                                    <Label Text="Включно без ЗП (інакше сайт їх приховує)" FontSize="12" TextColor="{DynamicResource White}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                                <Label Text="У списку Robota.ua лише назви, тому кожну вакансію відкриваємо окремо (~1–2 хв на сторінку)." FontSize="11" TextColor="{DynamicResource TextMuted}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </controls:CollapsibleSiteCard>
                    </VerticalStackLayout>

                    <controls:OverlaySheetFrame.FooterContent>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Закрити" Command="{Binding ToggleParsePanelCommand}" Style="{StaticResource CardAction}" />
                            <Button Grid.Column="1" Text="{Binding FetchButtonText}" Clicked="OnFetchAndCloseParseSheetClicked" Style="{StaticResource CardActionPrimary}" />
                        </Grid>
                    </controls:OverlaySheetFrame.FooterContent>
                </controls:OverlaySheetFrame>
            </DataTemplate>

            <DataTemplate x:Key="LocalFilterSheetTemplate" x:DataType="vm:CatalogViewModel">
                <!-- ==================== ШАР 2: OVERLAY SHEET — ЛОКАЛЬНІ ФІЛЬТРИ ==================== -->
                <controls:OverlaySheetFrame Title="Фільтри"
                                            CloseCommand="{Binding ToggleLocalFilterPanelCommand}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Швидкі умови" Style="{StaticResource SheetSectionTitle}" />
                        <FlexLayout Wrap="Wrap">
                            <controls:FilterChipControl Text="З ЗП" Command="{Binding ToggleUnifiedOnlyWithSalaryCommand}" IsActive="{Binding UnifiedOnlyWithSalary}" Margin="0,0,6,6" />
                            <controls:FilterChipControl Text="Активні" Command="{Binding ToggleUnifiedOnlyActiveCommand}" IsActive="{Binding UnifiedOnlyActive}" Margin="0,0,6,6" />
                            <controls:FilterChipControl Text="Без переглянутих" Command="{Binding ToggleUnifiedHideViewedCommand}" IsActive="{Binding UnifiedHideViewed}" IsVisible="{Binding CanTrackViews}" Margin="0,0,6,6" />
                            <controls:FilterChipControl Text="Включно без ЗП" Command="{Binding ToggleUnifiedIncludeNoSalaryCommand}" IsActive="{Binding UnifiedIncludeNoSalary}" Margin="0,0,6,6" />
                        </FlexLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0"><Label Text="Джерело" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding SourceFilterOptions}" SelectedItem="{Binding SelectedSourceFilter}" /></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"><Label Text="Формат роботи" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}" /></Border></VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout><Label Text="Сортування" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" /></Border></VerticalStackLayout>
                        <VerticalStackLayout><Label Text="Компанія" Style="{StaticResource CompactFieldLabel}" /><Border Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding UnifiedCompanyFilter}" ReturnCommand="{Binding FilterExistingCommand}" Placeholder="Назва компанії..." /></Border></VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Зарплата (від — до, валюта)" Style="{StaticResource CompactFieldLabel}" />
                            <Grid ColumnDefinitions="*,*,94" ColumnSpacing="6">
                                <Border Grid.Column="0" Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding MinSalaryFilter}" ReturnCommand="{Binding FilterExistingCommand}" Placeholder="Від" Keyboard="Numeric" /></Border>
                                <Border Grid.Column="1" Style="{StaticResource CompactFieldBorder}"><Entry Style="{StaticResource CompactEntry}" Text="{Binding MaxSalaryFilter}" ReturnCommand="{Binding FilterExistingCommand}" Placeholder="До" Keyboard="Numeric" /></Border>
                                <Border Grid.Column="2" Style="{StaticResource CompactFieldBorder}"><Picker Style="{StaticResource CompactPicker}" ItemsSource="{Binding SalaryCurrencyOptions}" SelectedItem="{Binding SelectedSalaryCurrency}" /></Border>
                            </Grid>
                        </VerticalStackLayout>

                        <controls:WordListEditorCard Title="Вайт-лист слів"
                                                     Placeholder="Слова через кому (C#, React...)"
                                                     ShowMatchMode="True"
                                                     MatchModeText="{Binding WhiteListMatchText}"
                                                     ToggleMatchModeCommand="{Binding ToggleWhiteListMatchAllCommand}"
                                                     Words="{Binding WhiteListWords}"
                                                     HasWords="{Binding HasWhiteListWords}"
                                                     NewWordText="{Binding NewWhiteListWord, Mode=TwoWay}"
                                                     AddWordCommand="{Binding AddWhiteListWordCommand}"
                                                     RemoveWordCommand="{Binding RemoveWhiteListWordCommand}"
                                                     ClearWordsCommand="{Binding ClearWhiteListWordsCommand}" />

                        <controls:WordListEditorCard Title="Бан-слова (виключити)"
                                                     Placeholder="Мінус-слова (Gambling, PHP...)"
                                                     IsDanger="True"
                                                     Words="{Binding BanListWords}"
                                                     HasWords="{Binding HasBanListWords}"
                                                     NewWordText="{Binding NewBanListWord, Mode=TwoWay}"
                                                     AddWordCommand="{Binding AddBanListWordCommand}"
                                                     RemoveWordCommand="{Binding RemoveBanListWordCommand}"
                                                     ClearWordsCommand="{Binding ClearBanListWordsCommand}" />
                    </VerticalStackLayout>

                    <controls:OverlaySheetFrame.FooterContent>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Скинути" Command="{Binding ResetFiltersCommand}" Style="{StaticResource CardAction}" />
                            <Button Grid.Column="1" Text="Застосувати фільтри" Clicked="OnApplyLocalFiltersClicked" Style="{StaticResource CardActionPrimary}" />
                        </Grid>
                    </controls:OverlaySheetFrame.FooterContent>
                </controls:OverlaySheetFrame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- ==================== ШАР 0: ОСНОВНИЙ КАТАЛОГ ==================== -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

            <!-- Рядок 0: Пошук + Сортування (іконка на Phone / Picker на Desktop) + Фільтри + (на Desktop: ⚙, Спарсити, ⋮) -->
            <controls:VacancySearchToolbar Grid.Row="0"
                                           SearchText="{Binding SearchText}"
                                           SearchPlaceholder="Пошук вакансій..."
                                           SearchCommand="{Binding FilterExistingCommand}"
                                           SortOptions="{Binding SortOptions}"
                                           SelectedSortOption="{Binding SelectedSortOption}"
                                           IsCustomSortActive="{Binding IsCustomSortActive}"
                                           SortMenuClicked="OnSortMenuClicked"
                                           FilterCommand="{Binding ToggleLocalFilterPanelCommand}"
                                           FilterDescription="Фільтри знайдених вакансій"
                                           IsFilterActive="{Binding IsFilterHighlightActive}">
                <HorizontalStackLayout Spacing="6" IsVisible="{OnIdiom Phone=False, Default=True}">
                    <Button Text="{x:Static res:Icons.SlidersHorizontal}"
                            Command="{Binding ToggleParsePanelCommand}"
                            Style="{StaticResource IconButton}"
                            HeightRequest="38" WidthRequest="38" MinimumHeightRequest="38" MinimumWidthRequest="38"
                            SemanticProperties.Description="Параметри парсингу сайтів">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsParsePanelVisible}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource InkPillBg}" />
                                <Setter Property="BorderColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{DynamicResource InkPillText}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="{Binding FetchButtonText}"
                            Command="{Binding FetchFromSitesCommand}"
                            Style="{StaticResource CardActionPrimary}"
                            FontSize="12"
                            Padding="14,6"
                            HeightRequest="38"
                            MinimumHeightRequest="38"
                            CornerRadius="10" />

                    <Button Text="{x:Static res:Icons.EllipsisVertical}"
                            Clicked="OnOverflowClicked"
                            Style="{StaticResource IconButton}"
                            HeightRequest="38" WidthRequest="38" MinimumHeightRequest="38" MinimumWidthRequest="38"
                            SemanticProperties.Description="Додаткові дії (експорт та імпорт)" />
                </HorizontalStackLayout>
            </controls:VacancySearchToolbar>

            <!-- Рядок 1 (лише Desktop): Компактна смуга швидких фільтрів + перехід до вибору сайтів у правій панелі -->
            <ScrollView Grid.Row="1"
                        IsVisible="{OnIdiom Phone=False, Default=True}"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="12,0,12,6">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <controls:FilterChipControl Text="{Binding ParseSitesChipText}"
                                                Command="{Binding ToggleParsePanelCommand}"
                                                SemanticProperties.Description="Налаштувати список сайтів для парсингу" />

                    <BoxView WidthRequest="1" HeightRequest="18" Color="{DynamicResource DividerColor}" Margin="2,0" VerticalOptions="Center" />

                    <controls:FilterChipControl Text="З ЗП" Command="{Binding ToggleUnifiedOnlyWithSalaryCommand}" IsActive="{Binding UnifiedOnlyWithSalary}" />
                    <controls:FilterChipControl Text="Активні" Command="{Binding ToggleUnifiedOnlyActiveCommand}" IsActive="{Binding UnifiedOnlyActive}" />
                    <controls:FilterChipControl Text="Без переглянутих" Command="{Binding ToggleUnifiedHideViewedCommand}" IsActive="{Binding UnifiedHideViewed}" IsVisible="{Binding CanTrackViews}" />
                    <controls:FilterChipControl Text="Обрати для ШІ" Command="{Binding ToggleSelectionModeCommand}" IsActive="{Binding Selection.IsSelectionMode}" IsVisible="{Binding CanTrackViews}" IsAccentText="True" />
                    <controls:FilterChipControl Text="Скинути" Command="{Binding ResetFiltersCommand}" IsAccentText="True" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Рядок 2: Гостьовий банер -->
            <Border Grid.Row="2"
                    IsVisible="{Binding IsGuestBannerVisible}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="{DynamicResource CardBorder}"
                    BackgroundColor="{DynamicResource DarkBg1}"
                    Margin="12,0,12,6"
                    Padding="11,8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="{x:Static res:Icons.TriangleAlert}" FontFamily="Lucide" FontSize="15" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Гостьовий режим" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{DynamicResource White}" />
                        <Label Text="Увійдіть для парсингу, обраного та відстаней." FontSize="11" TextColor="{DynamicResource TextMuted}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="Увійти" Command="{Binding NavigateToLoginCommand}" Style="{StaticResource CardActionPrimary}" FontSize="11" HeightRequest="30" MinimumHeightRequest="30" Padding="10,4" VerticalOptions="Center" />
                    <Button Grid.Column="3" Text="{x:Static res:Icons.X}" Command="{Binding DismissGuestBannerCommand}" Style="{StaticResource GhostIconButton}" WidthRequest="26" HeightRequest="26" MinimumWidthRequest="26" MinimumHeightRequest="26" FontSize="13" />
                </Grid>
            </Border>

            <!-- Рядок 3: Прогрес парсингу + банер кешу -->
            <VerticalStackLayout Grid.Row="3" Spacing="4" Margin="12,0,12,4">
                <Border IsVisible="{Binding IsSiteSearchRunning}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource PrimarySurface}"
                        Padding="12,8">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding SiteSearchStatusText}" FontSize="11.5" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Primary}" LineBreakMode="WordWrap" />
                        <ProgressBar Progress="{Binding SiteSearchProgress}" ProgressColor="{DynamicResource Primary}" HeightRequest="5" />
                    </VerticalStackLayout>
                </Border>

                <controls:ToastBanner Text="{Binding StaleCacheText}"
                                      Dismissed="OnDismissStatusBanner" />
            </VerticalStackLayout>

            <!-- Рядок 4: Банер помилки -->
            <Border Grid.Row="4"
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource ErrorBanner}"
                    Margin="12,0,12,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding ErrorMessage}" VerticalOptions="Center" Style="{StaticResource ErrorLabel}" FontSize="12" />
                    <Button Grid.Column="1" Text="{x:Static res:Icons.X}" Command="{Binding DismissErrorCommand}" Style="{StaticResource GhostIconButton}" TextColor="{DynamicResource Danger}" WidthRequest="26" HeightRequest="26" MinimumWidthRequest="26" MinimumHeightRequest="26" />
                </Grid>
            </Border>

            <!-- Рядок 5: Список вакансій (без фейкового RefreshView — плавний stretch на обох краях) -->
            <controls:VacancyListView x:Name="CatalogListView"
                                      Grid.Row="5"
                                      ItemsSource="{Binding Vacancies}"
                                      EnablePullToRefresh="False">
                <Grid>
                    <VerticalStackLayout Padding="28,36" Spacing="12" VerticalOptions="Center" IsVisible="{Binding IsBeforeFirstSearch}">
                        <Border WidthRequest="54" HeightRequest="54" StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="{DynamicResource PrimarySurface}" HorizontalOptions="Center">
                            <Label Text="{x:Static res:Icons.Globe}" FontFamily="Lucide" FontSize="24" TextColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Оберіть сайти та запустіть парсинг" HorizontalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource CardTitle}" FontSize="16" />
                        <Label Text="Свіжі вакансії з DOU, Work.ua, Djinni та Robota.ua з'являться тут одразу після збору." HorizontalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource MutedLabel}" MaximumWidthRequest="330" />
                        <VerticalStackLayout Spacing="8" MaximumWidthRequest="260" HorizontalOptions="Center" Margin="0,6,0,0">
                            <Button Text="{Binding FetchButtonText}" Command="{Binding FetchFromSitesCommand}" Style="{StaticResource CardActionPrimary}" HeightRequest="42" FontSize="13" />
                            <Button Text="Налаштувати сайти і фільтри" Command="{Binding ToggleParsePanelCommand}" Style="{StaticResource CardAction}" HeightRequest="40" FontSize="12.5" />
                        </VerticalStackLayout>
                        <Button Text="Відкрити Базу вакансій" Clicked="OnGoToDatabaseClicked" Style="{StaticResource LinkButton}" FontSize="12" HorizontalOptions="Center" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Padding="28,36" Spacing="10" VerticalOptions="Center" IsVisible="{Binding IsEmpty}">
                        <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="{DynamicResource TonalSurface}" HorizontalOptions="Center">
                            <Label Text="{x:Static res:Icons.Search}" FontFamily="Lucide" FontSize="22" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Вакансій за обраними критеріями не знайдено" HorizontalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource CardTitle}" />
                        <Label Text="Змініть фільтри сайтів і повторіть парсинг або скиньте локальні фільтри." HorizontalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource MutedLabel}" MaximumWidthRequest="330" />
                        <Button Text="Скинути фільтри" Command="{Binding ResetFiltersCommand}" HorizontalOptions="Center" Margin="0,6,0,0" Style="{StaticResource CardActionPrimary}" />
                    </VerticalStackLayout>
                </Grid>
                <controls:VacancyListView.FooterContent>
                    <!-- Пейджер усередині скролу: з'являється під списком, а не висить на екрані (FR-011, US-001 AC-2) -->
                    <controls:VacancyPagerBar Pager="{Binding Pager}" SummaryText="{Binding TotalText}" />
                </controls:VacancyListView.FooterContent>
            </controls:VacancyListView>

            <!-- Рядок 6: Панель вибору для групового ШІ-аналізу (FR-010), лише поки активний режим вибору -->
            <controls:VacancySelectionTray Grid.Row="6" Coordinator="{Binding Selection}" />
        </Grid>

        <!-- ==================== ШАР 1 & 2: ЛІНИВІ OVERLAY SHEETS ==================== -->
        <ContentView x:Name="ParseSheetHost" IsVisible="False" />
        <ContentView x:Name="LocalFilterSheetHost" IsVisible="False" />

        <!-- ==================== ШАР 3: КОНТЕКСТНЕ МЕНЮ ⋮ (ЯКІРНЕ, ЗА ТЕМОЮ) ==================== -->
        <controls:AnchoredPopupMenu x:Name="OverflowMenuLayer"
                                    MenuMargin="{OnIdiom Phone='0,4,12,0', Default='0,50,12,0'}">
            <VerticalStackLayout Spacing="2">
                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="10,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExportJsonTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.Download}" FontFamily="Lucide" FontSize="14" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Text="Експорт у JSON" FontSize="13" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="10,9"
                        IsVisible="{Binding CanTrackViews}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleSelectionModeTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.Sparkles}" FontFamily="Lucide" FontSize="14" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                        <Label Text="Обрати для ШІ" FontSize="13" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="10,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImportJsonTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{x:Static res:Icons.Upload}" FontFamily="Lucide" FontSize="14" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Text="Імпорт із JSON" FontSize="13" TextColor="{DynamicResource White}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </controls:AnchoredPopupMenu>

        <!-- ==================== ШАР 4: МЕНЮ СОРТУВАННЯ (ЯКІРНЕ НА PHONE) ==================== -->
        <controls:AnchoredPopupMenu x:Name="SortMenuLayer"
                                    MenuMargin="{OnIdiom Phone='0,46,56,0', Default='0,48,56,0'}">
            <VerticalStackLayout x:Name="SortOptionsStack" Spacing="2" />
        </controls:AnchoredPopupMenu>

    </Grid>
</ContentPage>
