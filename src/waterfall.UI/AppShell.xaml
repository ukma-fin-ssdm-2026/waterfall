<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="waterfall.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:waterfall.UI.Views"
    Title="Waterfall">

    <TabBar>
        <ShellContent
            Title="Каталог"
            ContentTemplate="{DataTemplate views:CatalogPage}"
            Route="catalog" />
        <ShellContent
            Title="Рекомендації"
            ContentTemplate="{DataTemplate views:RecommendationsPage}"
            Route="recommendations" />
        <ShellContent
            Title="ШІ-чат"
            ContentTemplate="{DataTemplate views:AIConsultantPage}"
            Route="aiconsultant" />
        <ShellContent
            Title="Аналітика"
            ContentTemplate="{DataTemplate views:AnalyticsPage}"
            Route="analytics" />
        <ShellContent
            Title="Обране"
            ContentTemplate="{DataTemplate views:FavoritesPage}"
            Route="favorites" />
        <ShellContent
            Title="Профіль"
            ContentTemplate="{DataTemplate views:LoginPage}"
            Route="login" />
    </TabBar>

</Shell>
