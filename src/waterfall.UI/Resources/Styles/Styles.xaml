<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base Controls (DynamicResource for live Dark / AMOLED / Light switching) -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource Secondary}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{DynamicResource DividerColor}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="40" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Primary}" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="38" />
        <Setter Property="MinimumWidthRequest" Value="38" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinimumHeightRequest" Value="38" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource Primary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="12" />
        <Setter Property="Opacity" Value="0.22" />
        <Setter Property="Brush" Value="#000000" />
        <Setter Property="Offset" Value="0,4" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Primary}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource Secondary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Primary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource OnPrimary}" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <!-- Page -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg2}" />
    </Style>

    <!-- ===== Warm Editorial Card & Content Tokens ===== -->

    <Style x:Key="VacancyCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 13" />
        <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="12,5" />
    </Style>

    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource White}" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SalaryLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="FontSize" Value="14.5" />
    </Style>

    <Style x:Key="BadgeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Borderless tonal skill chip (no box-inside-a-box clutter!) -->
    <Style x:Key="SkillChip" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource TonalSurface}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,5,5" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource TonalSurface}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <Style x:Key="AccentBadge" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySurface}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="CardAction" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg1}" />
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderColor" Value="{DynamicResource Secondary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinimumHeightRequest" Value="34" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.88" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.78" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="CardActionPrimary" TargetType="Button" BasedOn="{StaticResource CardAction}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="28" />
    </Style>

    <Style x:Key="ErrorBanner" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource Danger}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerSurface}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="12,8,12,0" />
    </Style>

    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Danger}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- ===== Warm Editorial Shared Primitives ===== -->

    <Style x:Key="IconGlyph" TargetType="Label">
        <Setter Property="FontFamily" Value="Lucide" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource CardAction}">
        <Setter Property="FontFamily" Value="Lucide" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Lucide" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="MinimumWidthRequest" Value="32" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="CompactFieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="2,0,0,3" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Канонічна геометрія поля: висота 44, горизонтальний відступ 12. -->
    <Style x:Key="CompactFieldBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 9" />
        <Setter Property="Stroke" Value="{DynamicResource Secondary}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DarkBg2}" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="CompactPicker" TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CompactEntry" TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="CompactCheckBox" TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Primary}" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="MinimumWidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Borderless tonal pill chip (90/8/2: active state switches to high-contrast InkPillBg / InkPillText!) -->
    <Style x:Key="FilterChip" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource TonalSurface}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="MinimumHeightRequest" Value="30" />
    </Style>

    <Style x:Key="SheetSectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
    </Style>

</ResourceDictionary>
