<?xml version="1.0" encoding="utf-8" ?>
<!-- Картка вакансії: спільна для «Каталогу» та «Обраного». BindingContext — VacancyItemViewModel. -->
<!-- AI: чипи навичок обмежено трьома з чипом «+N» (Lab 06); перевірено: збірка net10.0-windows, перегляд у запущеному застосунку. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Waterfall.Client.ViewModels;assembly=waterfall.Client"
             x:Class="waterfall.UI.Controls.VacancyCard"
             x:DataType="vm:VacancyItemViewModel">

    <Border Style="{StaticResource VacancyCard}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="6"
              ColumnSpacing="12">

            <Label Text="{Binding Title}"
                   Style="{StaticResource CardTitle}" />

            <Border Grid.Column="1"
                    Style="{StaticResource StatusBadge}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding StatusText}"
                       Style="{StaticResource BadgeLabel}" />
            </Border>

            <Label Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="{Binding CompanyLine}"
                   Style="{StaticResource MutedLabel}" />

            <Label Grid.Row="2"
                   Text="{Binding SalaryText}"
                   IsVisible="{Binding HasSalary}"
                   Style="{StaticResource SalaryLabel}" />

            <Label Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding SourceText}"
                   HorizontalOptions="End"
                   Style="{StaticResource MutedLabel}" />

            <Label Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Text="{Binding Description}"
                   MaxLines="3"
                   LineBreakMode="TailTruncation" />

            <!-- BindableLayout перезаписує дочірні елементи, тому чип «+N» стоїть поруч, у зовнішньому FlexLayout. -->
            <FlexLayout Grid.Row="4"
                        Wrap="Wrap">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding VisibleSkills}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{StaticResource SkillChip}">
                                <Label Text="{Binding .}"
                                       Style="{StaticResource BadgeLabel}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
                <Border Style="{StaticResource SkillChip}"
                        IsVisible="{Binding HasMoreSkills}">
                    <Label Text="{Binding MoreSkillsText}"
                           Style="{StaticResource BadgeLabel}" />
                </Border>
            </FlexLayout>

            <Button Grid.Row="4"
                    Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Command="{Binding ToggleSaveCommand}"
                    VerticalOptions="End"
                    Style="{StaticResource CardAction}"
                    SemanticProperties.Hint="Додати до обраного або прибрати з нього" />
        </Grid>
    </Border>
</ContentView>
