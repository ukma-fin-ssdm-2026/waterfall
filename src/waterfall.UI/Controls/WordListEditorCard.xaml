<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:waterfall.UI.Controls"
             xmlns:res="clr-namespace:waterfall.UI.Resources"
             x:Class="waterfall.UI.Controls.WordListEditorCard"
             x:Name="Root">

    <Border BindingContext="{x:Reference Root}"
            x:DataType="controls:WordListEditorCard"
            StrokeShape="RoundRectangle 10"
            Stroke="{DynamicResource CardBorder}"
            BackgroundColor="{DynamicResource DarkBg2}"
            Padding="10,8">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsDanger}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Danger}" />
            </DataTrigger>
        </Border.Triggers>

        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Label Grid.Column="0"
                       Text="{Binding Title}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12"
                       TextColor="{DynamicResource White}"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsDanger}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Button Grid.Column="1"
                        Text="{Binding MatchModeText}"
                        Command="{Binding ToggleMatchModeCommand}"
                        IsVisible="{Binding ShowMatchMode}"
                        Style="{StaticResource FilterChip}"
                        HeightRequest="26"
                        MinimumHeightRequest="26"
                        Padding="8,2"
                        FontSize="10.5" />

                <Button Grid.Column="2"
                        Text="Очистити"
                        Command="{Binding ClearWordsCommand}"
                        IsVisible="{Binding HasWords}"
                        Style="{StaticResource LinkButton}"
                        FontSize="11"
                        TextColor="{DynamicResource TextSecondary}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Border Grid.Column="0"
                        Style="{StaticResource CompactFieldBorder}"
                        BackgroundColor="{DynamicResource DarkBg1}">
                    <Entry Style="{StaticResource CompactEntry}"
                           Text="{Binding NewWordText, Mode=TwoWay}"
                           ReturnCommand="{Binding AddWordCommand}"
                           Placeholder="{Binding Placeholder}" />
                </Border>

                <Button Grid.Column="1"
                        Text="{x:Static res:Icons.Plus}"
                        Command="{Binding AddWordCommand}"
                        Style="{StaticResource IconButton}"
                        BackgroundColor="{DynamicResource InkPillBg}"
                        BorderColor="Transparent"
                        TextColor="{DynamicResource InkPillText}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsDanger}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Danger}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <FlexLayout Wrap="Wrap"
                        IsVisible="{Binding HasWords}"
                        BindableLayout.ItemsSource="{Binding Words}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border StrokeShape="RoundRectangle 7"
                                StrokeThickness="0"
                                BackgroundColor="{DynamicResource TonalSurface}"
                                Padding="8,3"
                                Margin="0,0,5,5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Source={RelativeSource AncestorType={x:Type controls:WordListEditorCard}}, Path=IsDanger}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource DangerSurface}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding .}"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{DynamicResource White}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type controls:WordListEditorCard}}, Path=IsDanger}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Button Text="{x:Static res:Icons.X}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type controls:WordListEditorCard}}, Path=RemoveWordCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource GhostIconButton}"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        MinimumWidthRequest="18"
                                        MinimumHeightRequest="18"
                                        FontSize="11">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type controls:WordListEditorCard}}, Path=IsDanger}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
