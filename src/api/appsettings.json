{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=waterfall.db"
  },
  "Jwt": {
    "Issuer": "Waterfall",
    "Audience": "WaterfallClients",
    "ExpiresMinutes": 15
  },
  "Ingestion": {
    "Enabled": true,
    "Interval": "00:30:00",
    "DjinniPages": 3,
    "RequestDelay": "00:00:02",
    "RawDataDirectory": ""
  }
}
