{
  "name": "waterfall-api",
  "version": "v1",
  "description": "MCP Server generated from OpenAPI spec for waterfall-api",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && node -e \"require('node:fs').chmodSync('build/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "lint": "eslint src --max-warnings 0",
    "audit:deps": "npm audit --audit-level=moderate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "axios": "^1.9.0",
    "dotenv": "^16.4.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.2",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  }
}
